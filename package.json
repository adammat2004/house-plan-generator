{
  "name": "floor-plan-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "plans:render": "vitest run --config vitest.plans.config.mts render",
    "plans:bench": "vitest run --config vitest.plans.config.mts bench",
    "test:e2e": "NEXT_PUBLIC_MAPTILER_KEY= next build && playwright test --project=desktop --project=phone",
    "test:screens": "bash scripts/screens.sh",
    "test:screens:update": "bash scripts/screens.sh --update-snapshots",
    "eval": "vitest run --config vitest.eval.config.mts",
    "assets:build": "vitest run --config vitest.assets.config.mts build",
    "assets:publish": "vitest run --config vitest.assets.config.mts publish",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/genai": "^2.28.0",
    "@types/three": "^0.186.0",
    "jspdf": "^4.2.1",
    "konva": "10.7.1",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.0",
    "polygon-clipping": "0.15.7",
    "proj4": "2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "three": "^0.186.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fal-ai/client": "^1.10.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.5",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
